    "LICENSE",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TetreesEX/TetreesAgent_EX.git"
  },
  "homepage": "https://ex.tetrees.ai/en/mcp",
  "bugs": {
